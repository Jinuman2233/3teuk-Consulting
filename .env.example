# Official Supabase JS env names for this Next.js app.
# Application reads use the project URL and the public (publishable or legacy anon) key only.
# Do not set a service_role / secret key. This app never reads those variables.
#
# These names use the NEXT_PUBLIC_ prefix because that is the documented
# Next.js contract from Supabase. This repository still reads them only from
# server modules (lib/supabase/server.ts). Do not import that client from
# Client Components.
#
# Copy to .env.local and fill in values. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Current Connect-panel / API Keys name (preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy dashboard name. Used only when the publishable key is unset:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
